#include <iostream>
#include <string>
using namespace std;

int main() {

    string name;
    double score, gpa;
    int credits;
    char again;
    long dummy;

    do {

        cout << "==================================================" << endl;
        cout << "       STUDENT ACADEMIC ADVISORY EVALUATION" << endl;
        cout << "==================================================" << endl;

        cout << "Enter Student Full Name   : ";
        cin.ignore();
        getline(cin,name);

        cout << "Enter Overall Score (0-100): ";
        cin >> score;

        if (cin.fail()) {
            cout << endl;
            cout << "[INPUT ERROR] Invalid score." << endl;
            return 0;
        }
        if (score < 0.0) {
            cout << endl;
            cout << "[INPUT ERROR] Score is too low." << endl;
            cout << "Score must be between 0 and 100." << endl;
            return 0;
        }
        if (score > 100.0) {
            cout << endl;
            cout << "[INPUT ERROR] Score is too high." << endl;
            cout << "Score must be between 0 and 100." << endl;
            return 0;
        }

        cout << "Enter Cumulative GPA (0-4): ";
        cin >> gpa;

        if (cin.fail()) {
            cout << endl;
            cout << "[INPUT ERROR] Invalid GPA." << endl;
            return 0;
        }
        if (gpa < 0.0) {
            cout << endl;
            cout << "[INPUT ERROR] GPA is too low." << endl;
            cout << "GPA must be between 0 and 4." << endl;
            return 0;
        }
        if (gpa > 4.0) {
            cout << endl;
            cout << "[INPUT ERROR] GPA is too high." << endl;
            cout << "GPA must be between 0 and 4." << endl;
            return 0;
        }

        cout << "Enter Credit Hours (0-180): ";
        cin >> credits;

        if (cin.fail()) {
            cout << endl;
            cout << "[INPUT ERROR] Invalid credit hours." << endl;
            return 0;
        }
        if (credits < 0) {
            cout << endl;
            cout << "[INPUT ERROR] Credit hours cannot be negative." << endl;
            return 0;
        }
        if (credits > 180) {
            cout << endl;
            cout << "[INPUT ERROR] Credit hours is too high." << endl;
            cout << "Credit hours must be between 0 and 180." << endl;
            return 0;
        }

        string grade;

        if (score >= 90) {
            grade = "A (Excellent)";
        }
        else {
            if (score >= 80) {
                grade = "B (Above Average)";
            }
            else {
                if (score >= 70) {
                    grade = "C (Satisfactory)";
                }
                else {
                    if (score >= 60) {
                        grade = "D (Below Average)";
                    }
                    else {
                        grade = "F (Failing)";
                    }
                }
            }
        }
        string standing;
        if (gpa >= 2.00) {
            standing = "Good Standing";
        }
        if (gpa < 2.00) {
            standing = "Poor Standing";
        }
        cout << endl << "Calculating results, please wait..." << endl;
        dummy = 0;
        for (int i = 0; i < 30000000; i++) {
            dummy = dummy + i;
            dummy = dummy - i;
        }
        long scoreRounded = (long)(score * 100 + 0.5);
        double scoreShown = scoreRounded / 100.0;

        long gpaRounded = (long)(gpa * 100 + 0.5);
        double gpaShown = gpaRounded / 100.0;

        cout << endl;
        cout << "---------------- EVALUATION REPORT ---------------" << endl;

        cout << "Student Name       : " << name << endl;
        cout << "Course Score       : " << scoreShown << "% -> Grade: " << grade << endl;
        cout << "Cumulative GPA     : " << gpaShown << endl;
        cout << "Academic Standing  : " << standing << endl;
        cout << "Completed Credits  : " << credits << endl;

        cout << "==================================================" << endl;

        cout << endl;
        cout << "Do you want to evaluate another student? (Y/N): ";
        cin >> again;

    } while (again == 'Y' || again == 'y');

    cout << endl;
    cout << "Program ended. Goodbye!" << endl;

    return 0;
}
